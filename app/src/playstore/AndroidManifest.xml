<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Play Store build only: the free launcher icon, baked in. The direct
         (Ko-fi) build declares its own premium icon in its flavor manifest.
         Exactly one launcher alias exists per build, so no runtime icon swap
         ever happens. -->
    <application>
        <activity-alias
            android:name=".LauncherFree"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher_free"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
